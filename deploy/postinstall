#!/bin/bash
# pkg postinstall: runs as root.
# Per-user LaunchAgent loading is still handled by INSTALL.command.
chmod -R a+rX "/Applications/ACOS Student Agent.app" 2>/dev/null || true
chmod 755 "/Applications/ACOS Student Agent.app/Contents/MacOS/acos-agent" 2>/dev/null || true
chmod 644 /usr/local/acos/com.acos.studentagent.plist 2>/dev/null || true
codesign --verify --deep --strict "/Applications/ACOS Student Agent.app" >/dev/null 2>&1 || true
exit 0
